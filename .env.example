# Copy to .env. Use HTTPS for any public deployment.
APP_ORIGIN=http://localhost:4321
DATABASE_PATH=./data/auralogic-citas.sqlite
HOST=127.0.0.1
PORT=4321
# Optional worker. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENABLED=false
WHATSAPP_ENCRYPTION_KEY=
# Local seed only. Set both before npm run db:seed; no default password is shipped.
SEED_EMAIL=
SEED_PASSWORD=
